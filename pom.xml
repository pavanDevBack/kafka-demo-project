<?xml version="1.0" encoding="UTF-8"?>
<!--
  POM agregador: só serve para abrir os dois serviços como um projeto único na IDE
  e para compilar tudo com um comando (mvn package). Cada serviço tem o próprio parent
  do Spring Boot e roda de forma independente.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>br.edu.sd</groupId>
    <artifactId>kafka-demo-with-spring-boot</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Kafka Demo with Spring Boot</name>

    <modules>
        <module>pedido-producer</module>
        <module>pedido-consumer</module>
    </modules>
</project>
